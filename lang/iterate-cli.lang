import Lang.Prelude
import Lang.Prelude.Instances
import Lang.Cli.Process
import Lang.Cli.Text
import Lang.Text.MachineParse


-- The requested recurrence, with every input supplied at runtime.
fn iterate : Uint64 -> Uint64 -> Uint64 -> Uint64 -> Uint64
iterate n a b seed =
  if Uint64.eq n 0u64 then seed
  else Uint64.add (Uint64.mul a (iterate (Uint64.sub n 1u64) a b seed)) b

proc argument : Int64 -> Maybe(Uint64)
argument index =
  match cli_argument_nth (cli_arguments !cli_process) index with
    nothing -> nothing
    just text -> integer_parse_digits integer_u64 radix_decimal 18446744073709551615u64 false text 0i64
  end

-- An optional positional argument: absent -> the default, present -> must parse.
proc argument_or : Int64 -> Uint64 -> Maybe(Uint64)
argument_or index fallback =
  if Int64.le (cli_argument_count_native ()) index then just fallback else argument index

proc usage : Unit
usage =
  let _ = cli_write_line cli_stderr "usage: iterate [n [a [b [seed]]]] (unsigned 64-bit decimal integers; defaults 5000000000 3 5 7)" in
  absurd (cli_exit cli_process 2i64)

proc main : Unit
main =
  if Int64.gt (cli_argument_count_native ()) 5i64 then usage else
  match argument_or 1i64 5000000000u64 with
    nothing -> usage
    just n -> match argument_or 2i64 3u64 with
      nothing -> usage
      just a -> match argument_or 3i64 5u64 with
        nothing -> usage
        just b -> match argument_or 4i64 7u64 with
          nothing -> usage
          just seed -> let _ = cli_write_line cli_stdout (integer_render integer_u64 radix_decimal (the iterate n a b seed)) in ()
        end
      end
    end
  end
