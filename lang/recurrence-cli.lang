import Lang.Prelude
import Lang.Prelude.Instances
import Lang.Prelude.Typeclasses.Sum
import SumOps
import Lang.Prelude.Typeclasses.Sub
import SubOps
import Lang.Prelude.Typeclasses.Eq
import EqOps
import Lang.Cli.Process
import Lang.Cli.Text
import Lang.Text.MachineParse
fn recurrence : Uint64 -> Uint64 -> Uint64 -> Uint64
recurrence n a b =
  if n == 0u64 then a
  else if n == 1u64 then b
  else
    let x = recurrence (n - 1u64) a b in
    let y = recurrence (n - 2u64) a b in
    x + x + x + y + y + 5u64
proc argument : Int64 -> Maybe(Uint64)
argument index =
  match cli_argument_nth (cli_arguments !cli_process) index with
    nothing -> nothing
    just text -> integer_parse_digits integer_u64 radix_decimal 18446744073709551615u64 false text 0i64
  end

-- An optional positional argument: absent -> the default, present -> must parse.
proc argument_or : Int64 -> Uint64 -> Maybe(Uint64)
argument_or index fallback =
  if Int64.le (cli_argument_count_native ()) index then just fallback else argument index
proc usage : Unit
usage =
  let _ = cli_write_line cli_stderr "usage: recurrence [n [a [b]]] (unsigned 64-bit decimal integers; defaults 44 2 3)" in
  absurd (cli_exit cli_process 2i64)
proc main : Unit
main =
  if Int64.gt (cli_argument_count_native ()) 4i64 then usage else
  match argument_or 1i64 44u64 with
    nothing -> usage
    just n -> match argument_or 2i64 2u64 with
      nothing -> usage
      just a -> match argument_or 3i64 3u64 with
        nothing -> usage
        just b -> let _ = cli_write_line cli_stdout (integer_render integer_u64 radix_decimal (the recurrence n a b)) in ()
      end
    end
  end

-- Public call boundary for the same recurrence in the comparison suite.
fn benchmark : Uint64 -> Uint64 -> Uint64 -> Uint64
benchmark n a b = the Uint64 in recurrence n a b
