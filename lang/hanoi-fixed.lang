import Lang.Prelude
import Lang.Prelude.Instances
import Lang.Prelude.Typeclasses.Sum
import SumOps
import Lang.Prelude.Typeclasses.Sub
import SubOps
import Lang.Prelude.Typeclasses.Eq
import EqOps
import Lang.Cli.Text
import Lang.Text.MachineFormat
import Lang.Cli.Process
import Lang.Text.MachineParse

fn hanoi : Uint64 -> Uint64 -> Uint64
hanoi disks moves = if disks == 0u64 then moves
  else hanoi (disks - 1u64) (hanoi (disks - 1u64) moves + 1u64)

fn benchmark : Uint64 -> Uint64
benchmark disks = the hanoi disks 0u64

proc argument : Int64 -> Maybe(Uint64)
argument index =
  match cli_argument_nth (cli_arguments !cli_process) index with
    nothing -> nothing
    just text -> integer_parse_digits integer_u64 radix_decimal 18446744073709551615u64 false text 0i64
  end

-- An optional positional argument: absent -> the default, present -> must parse.
proc argument_or : Int64 -> Uint64 -> Maybe(Uint64)
argument_or index fallback =
  if Int64.le (cli_argument_count_native ()) index then just fallback else argument index

proc usage : Unit
usage =
  let _ = cli_write_line cli_stderr "usage: hanoi [disks, 0..63] (default 31)" in
  absurd (cli_exit cli_process 2i64)

proc main : Unit
main =
  if Int64.gt (cli_argument_count_native ()) 2i64 then usage else
  match argument_or 1i64 31u64 with
    nothing -> usage
    just disks -> if Uint64.gt disks 63u64 then usage else
      let _ = cli_write_line cli_stdout (integer_render integer_u64 radix_decimal (benchmark disks)) in ()
  end
