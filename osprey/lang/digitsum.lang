import Osprey.Arguments
import Lang.Prelude
import Lang.Prelude.Instances
import SumOps
import SubOps
import DivOps
import ModOps
import EqOps
import OrdOps
import Lang.Cli.Text
import Lang.Text.MachineFormat
import Lang.Data.List

fn range : Uint64 -> Uint64 -> List(Uint64)
range first last =
  if first > last then nil
  else cons first (if first == last then nil else range (first + 1u64) last)

fn digit_sum : Uint64 -> Uint64
digit_sum n = if n < 10u64 then n else n % 10u64 + digit_sum (n / 10u64)

fn benchmark : Uint64 -> Uint64
benchmark limit =
  list_fold_left (\total n -> total + digit_sum n) 0u64 (range 1u64 limit)

proc main : Unit
main = the Unit in
  let parameter_1 = osprey_argument 1i64 in
  let _ = cli_write_line cli_stdout
  (integer_render integer_u64 radix_decimal (benchmark parameter_1)) in ()
