import Osprey.Arguments
import Lang.Prelude
import Lang.Prelude.Instances
import SumOps
import ProductOps
import SubOps
import DivOps
import ModOps
import EqOps
import OrdOps
import Lang.Cli.Text
import Lang.Text.MachineFormat
import Lang.Data.List

fn range : Uint64 -> Uint64 -> List(Uint64)
range first last =
  if first > last then nil
  else cons first (if first == last then nil else range (first + 1u64) last)

fn has_factor : Uint64 -> Uint64 -> Bool
has_factor n divisor =
  if divisor < 2u64 then false
  else if divisor >= n then false
  else if divisor > n / divisor then false
  else if n % divisor == 0u64 then true
  else has_factor n (divisor + 1u64)

fn is_prime : Uint64 -> Bool
is_prime n = if n < 2u64 then false else Bool.not (has_factor n 2u64)

fn benchmark : Uint64 -> Uint64
benchmark limit =
  list_fold_left (\total n -> if is_prime n then total + 1u64 else total) 0u64 (range 2u64 limit)

proc main : Unit
main = the Unit in
  let parameter_1 = osprey_argument 1i64 in
  let _ = cli_write_line cli_stdout
  (integer_render integer_u64 radix_decimal (benchmark parameter_1)) in ()
