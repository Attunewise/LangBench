import Osprey.Arguments
import Lang.Prelude
import Lang.Prelude.Instances
import SumOps
import SubOps
import ModOps
import EqOps
import Lang.Cli.Text
import Lang.Text.MachineFormat

fn gcd : Uint64 -> Uint64 -> Uint64
gcd a b = if b == 0u64 then a else gcd b (a % b)

fn row : Uint64 -> Uint64 -> Uint64
row i j = if j == 0u64 then 0u64
  else (if gcd i j == 1u64 then 1u64 else 0u64) + row i (j - 1u64)

fn pairs : Uint64 -> Uint64 -> Uint64
pairs i limit = if i == 0u64 then 0u64 else row i limit + pairs (i - 1u64) limit

fn benchmark : Uint64 -> Uint64
benchmark limit = pairs limit limit

proc main : Unit
main = the Unit in
  let parameter_1 = osprey_argument 1i64 in
  let _ = cli_write_line cli_stdout
  (integer_render integer_u64 radix_decimal (benchmark parameter_1)) in ()
