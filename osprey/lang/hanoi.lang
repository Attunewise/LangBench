import Osprey.Arguments
import Lang.Prelude
import Lang.Prelude.Instances
import SumOps
import SubOps
import EqOps
import Lang.Cli.Text
import Lang.Text.MachineFormat

fn hanoi : Uint64 -> Uint64 -> Uint64
hanoi disks moves = if disks == 0u64 then moves
  else hanoi (disks - 1u64) (hanoi (disks - 1u64) moves + 1u64)

fn benchmark : Uint64 -> Uint64
benchmark disks = hanoi disks 0u64

proc main : Unit
main = the Unit in
  let parameter_1 = osprey_argument 1i64 in
  let _ = cli_write_line cli_stdout
  (integer_render integer_u64 radix_decimal (benchmark parameter_1)) in ()
