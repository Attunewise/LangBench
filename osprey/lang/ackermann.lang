import Lang.Prelude
import Lang.Prelude.Instances
import SumOps
import SubOps
import EqOps
import Lang.Cli.Process
import Lang.Cli.Text
import Lang.Text.MachineParse

fn ackermann : Uint64 -> Uint64 -> Uint64
ackermann m n =
  if m == 0u64 then n + 1u64
  else if n == 0u64 then ackermann (m - 1u64) 1u64
  else ackermann (m - 1u64) (ackermann m (n - 1u64))

proc argument : Int64 -> Maybe(Uint64)
argument index =
  match cli_argument_nth (cli_arguments !cli_process) index with
    nothing -> nothing
    just text -> integer_parse_digits integer_u64 radix_decimal 18446744073709551615u64 false text 0i64
  end

proc usage : Unit
usage =
  let _ = cli_write_line cli_stderr "usage: ackermann <m> <n> (unsigned 64-bit decimal integers)" in
  absurd (cli_exit cli_process 2i64)

proc main : Unit
main = the Unit in
  if Int64.ne (cli_argument_count_native ()) 3i64 then usage else
  match argument 1i64 with
    nothing -> usage
    just m -> match argument 2i64 with
      nothing -> usage
      just n -> let _ = cli_write_line cli_stdout (integer_render integer_u64 radix_decimal (ackermann m n)) in ()
    end
  end
