import Lang.Prelude

-- The consumer's coefficient is determined by the complete producer. Its
-- payloads have different telescopes and the observation is order-sensitive.
data Rows where
  done : Rows
  single : Int32 -o Rows -o Rows
  mixed : Int32 -o Float64 -o Rows -o Rows
end

fn consume : Int32 -> Rows -o Int32
consume coefficient rows = Rows.fold 17i32
  (\word rest -o Int32.sub (Int32.mul word coefficient) rest)
  (\word fraction rest -o Int32.add (Int32.sub (Int32.mul word 3i32) rest)
    (if Float64.lt fraction 0.0f64 then coefficient else Int32.sub 0i32 coefficient)) rows

fn build : Int64 -> Int64 -> Int32 -> Rows -o Int32
build remaining index coefficient rows =
  if Int64.gt remaining 0i64 then
    let word = Int32.sub (Int32.mul (Int32.from_int64 index) 7919i32) 97i32 in
    let next = if Int64.eq (Int64.rem index 3i64) 0i64
      then single word rows
      else mixed word (if Int64.eq (Int64.rem index 2i64) 0i64 then -0.5f64 else 0.25f64) rows in
    build (Int64.sub remaining 1i64) (Int64.add index 1i64) (Int32.bit_xor coefficient word) next
  else consume coefficient rows

fn benchmark : Int64 -> Int32
benchmark count = the Int32 in build count 0i64 7i32 done

import Lang.Cli.Process
import Lang.Cli.Text
import Lang.Text.MachineParse

proc argument : Int64 -> Maybe(Uint64)
argument index =
  match cli_argument_nth (cli_arguments !cli_process) index with
    nothing -> nothing
    just text -> integer_parse_digits integer_u64 radix_decimal 18446744073709551615u64 false text 0i64
  end

-- An optional positional argument: absent -> the default, present -> must parse.
proc argument_or : Int64 -> Uint64 -> Maybe(Uint64)
argument_or index fallback =
  if Int64.le (cli_argument_count_native ()) index then just fallback else argument index

proc usage : Unit
usage =
  let _ = cli_write_line cli_stderr "usage: fibers-dynamic [count: 0..10000000] (default 8388608)" in
  absurd (cli_exit cli_process 2i64)

proc main : Unit
main =
  if Int64.gt (cli_argument_count_native ()) 2i64 then usage else
  match argument_or 1i64 8388608u64 with
    nothing -> usage
    just count -> if Uint64.gt count 10000000u64 then usage else
      let result = benchmark (Int64.from_uint64 count) in
      let _ = cli_write_line cli_stdout (integer_render integer_i32 radix_decimal result) in ()
  end
